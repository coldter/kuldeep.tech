---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  project: CollectionEntry<"work">;
  loading?: "eager" | "lazy" | undefined | null;
}

const {
  loading,
  project: { data, id },
} = Astro.props;
---

<a class="card" href={`/work/${id}`}>
  <span class="title">{data.title}</span>
  <Image
    src={data.img}
    alt={data.img_alt || ""}
    widths={[240, 540, 720, data.img.width]}
    sizes={`(max-width: 360px) 240px, (max-width: 720px) 540px, (max-width: 1600px) 720px, ${data.img.width}px`}
    loading={loading}
  />
</a>

<style>
  .card {
    display: grid;
    grid-template: auto 1fr / auto 1fr;
    height: 11rem;
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    font-family: var(--font-brand);
    font-size: var(--text-lg);
    font-weight: 500;
    transition:
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.4s ease;
    will-change: transform;
  }

  .card:hover {
    box-shadow:
      var(--shadow-md),
      0 0 0 1px var(--accent-subtle-overlay);
    transform: translateY(-4px);
    border-color: var(--gray-600);
  }

  .card:active {
    transform: translateY(-1px);
    transition-duration: 0.2s;
  }

  .title {
    grid-area: 1 / 1 / 2 / 2;
    z-index: 1;
    margin: 0.75rem;
    padding: 0.5rem 1rem;
    background: var(--gray-999_40);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--gray-0);
    border: 1px solid hsla(0, 0%, 100%, 0.08);
    box-shadow: inset 0 1px 0 hsla(0, 0%, 100%, 0.05);
    border-radius: 0.5rem;
    transition:
      background 0.4s ease,
      color 0.4s ease,
      border-color 0.4s ease;
  }

  .card:hover .title {
    background: hsla(var(--gray-999-basis), 0.85);
    color: var(--accent-regular);
    border-color: hsla(var(--gray-999-basis), 0.3);
  }

  img {
    grid-area: 1 / 1 / 3 / 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card:hover img {
    transform: scale(1.04);
  }

  @media (min-width: 50em) {
    .card {
      height: 22rem;
      border-radius: 1rem;
    }

    .title {
      border-radius: 0.75rem;
    }
  }
</style>
