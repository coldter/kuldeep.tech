---
const currentYear = new Date().getFullYear();

/** Kept deliberately short: profile links live in the header. */
const links: { label: string; href: string; external?: boolean }[] = [
  { label: "GitHub", href: "https://github.com/coldter", external: true },
  { label: "Site admin", href: "/admin/" },
];
---

<footer>
  <div class="footer-content">
    <div class="group">
      <p>&copy; <time class="tabular">{currentYear}</time> Kuldeep Parmar</p>
    </div>
    <ul class="socials">
      {
        links.map(({ label, href, external }) => (
          <li>
            <a
              href={href}
              target={external ? "_blank" : undefined}
              rel={external ? "noopener noreferrer" : undefined}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
<style>
  footer {
    display: flex;
    flex-direction: column;
    margin-top: auto;
    padding: 3rem 2rem calc(3rem + env(safe-area-inset-bottom));
    text-align: center;
    color: var(--gray-400);
    font-size: var(--text-sm);
    border-top: 1px solid var(--gray-800);
    background: var(--gray-999_40);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 83rem;
    margin: 0 auto;
    width: 100%;
  }

  footer a {
    color: var(--gray-300);
    text-decoration: none;
    transition: color var(--theme-transition);
  }

  footer a:hover,
  footer a:focus-visible {
    color: var(--accent-regular);
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .socials {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-weight: 500;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 50em) {
    .footer-content {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 0 3rem;
    }

    .group {
      flex-direction: row;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .socials {
      justify-content: flex-end;
    }
  }
</style>
