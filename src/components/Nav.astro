---
import Icon from "./Icon.astro";
import SoundToggle from "./SoundToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";
import type { iconPaths } from "./IconPaths";

/** Main menu items */
const textLinks: { label: string; href: string }[] = [
  { label: "Home", href: "/" },
  { label: "Work", href: "/work/" },
  { label: "About", href: "/about/" },
];

/** Icon links to social profiles and off-site pages. */
const iconLinks: {
  label: string;
  href: string;
  icon: keyof typeof iconPaths;
}[] = [
  { label: "GitHub", href: "https://github.com/coldter", icon: "github-logo" },
  { label: "Resume", href: "https://cv.kuldeep.tech", icon: "cv" },
  { label: "Letterboxd", href: "https://letterboxd.com/kicksss/", icon: "letterboxd" },
];

/** Test if a link is pointing to the current page. */
const isCurrentPage = (href: string) => {
  let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
  if (pathname.at(0) !== "/") pathname = "/" + pathname;
  if (pathname.at(-1) !== "/") pathname += "/";
  return pathname === href || (href !== "/" && pathname.startsWith(href));
};
---

<nav>
  <a href="/" class="site-title">
    <Icon
      icon="terminal-simple"
      color="var(--accent-regular)"
      size="1.6em"
      gradient
    />
    Kuldeep Parmar
  </a>

  <!-- No-JS: links and socials are simply visible. -->
  <noscript>
    <div class="fallback">
      <ul class="nav-items">
        {
          textLinks.map(({ label, href }) => (
            <li>
              <a
                aria-current={isCurrentPage(href) ? "page" : null}
                class="link"
                href={href}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="socials">
        {
          iconLinks.map(({ href, icon, label }) => (
            <a
              href={href}
              class="social"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="sr-only">{label}</span>
              <Icon icon={icon} />
            </a>
          ))
        }
      </div>
    </div>
  </noscript>

  <!-- Dropdown on small screens, inline centre column on large ones.
       JS relocates .socials out of here into .controls at desktop width, so
       there is only ever one copy of each link. -->
  <div id="menu-content" hidden>
    <ul class="nav-items">
      {
        textLinks.map(({ label, href }) => (
          <li>
            <a
              aria-current={isCurrentPage(href) ? "page" : null}
              class="link"
              href={href}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="socials">
      {
        iconLinks.map(({ href, icon, label }) => (
          <a
            href={href}
            class="social"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="sr-only">{label}</span>
            <Icon icon={icon} />
          </a>
        ))
      }
    </div>
  </div>

  <!-- Always in the bar, at every width, so sound is never buried. -->
  <div class="controls">
    <SoundToggle />
    <ThemeToggle />
    <menu-button>
      <template>
        <button class="menu-button" aria-expanded="false" aria-controls="menu-content">
          <span class="sr-only">Open menu</span>
          <Icon icon="list" />
        </button>
      </template>
    </menu-button>
  </div>
</nav>

<script>
  class MenuButton extends HTMLElement {
    constructor() {
      super();

      // Inject menu toggle button when JS runs.
      this.appendChild(this.querySelector("template")!.content.cloneNode(true));
      const btn = this.querySelector("button")!;

      const menu = document.getElementById("menu-content")!;
      menu.hidden = true;

      const socials = document.querySelector("nav .socials");
      const controls = document.querySelector("nav .controls");

      const setExpanded = (expand: boolean) => {
        btn.setAttribute("aria-expanded", expand ? "true" : "false");
        const label = btn.querySelector(".sr-only");
        if (label) label.textContent = expand ? "Close menu" : "Open menu";
        menu.hidden = !expand;
      };

      /**
       * Socials belong in the top-right cluster on desktop and inside the
       * dropdown on mobile. Moving one node rather than rendering two keeps
       * the link list unambiguous for screen readers.
       */
      const placeSocials = (desktop: boolean) => {
        if (!socials || !controls) return;
        const target = desktop ? controls : menu;
        if (socials.parentElement === target) return;
        if (desktop) controls.prepend(socials);
        else menu.append(socials);
      };

      btn.addEventListener("click", () => setExpanded(!!menu.hidden));

      // Close on Escape and return focus to the trigger.
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !menu.hidden && !btn.hidden) {
          setExpanded(false);
          btn.focus();
        }
      });

      // Hide menu button for large screens.
      const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
        setExpanded(e.matches);
        btn.hidden = e.matches;
        placeSocials(e.matches);
      };
      const mediaQueries = window.matchMedia("(min-width: 50em)");
      handleViewports(mediaQueries);
      mediaQueries.addEventListener("change", handleViewports);
    }
  }
  customElements.define("menu-button", MenuButton);
</script>

<style>
  nav {
    z-index: 50;
    position: relative;
    /* Sits on the grid backdrop; keep it light so the field stays visible. */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem;
    font-family: var(--font-brand);
    font-weight: 500;
    margin-bottom: 2.5rem;
  }

  .site-title {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    line-height: 1.1;
    color: var(--gray-0);
    text-decoration: none;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    white-space: nowrap;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Icon links. Borderless and a touch smaller than the sound/theme pair, so
     the controls read as primary and the socials as secondary. */
  .socials {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999rem;
    color: var(--gray-400);
    text-decoration: none;
    font-size: 1.05rem;
    transition:
      color var(--theme-transition),
      background-color var(--theme-transition),
      transform var(--theme-transition);
  }

  .social:hover,
  .social:focus-visible {
    color: var(--gray-0);
    background-color: var(--accent-subtle-overlay);
    transform: translateY(-2px);
  }

  /* No-JS fallback: plain row. */
  .fallback {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .menu-button {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--gray-800);
    border-radius: 999rem;
    width: 2rem;
    height: 2rem;
    padding: 0;
    font-size: 1.1rem;
    color: var(--gray-300);
    background: var(--gray-999_40);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    cursor: pointer;
    transition:
      color var(--theme-transition),
      background var(--theme-transition),
      border-color var(--theme-transition);
  }

  .menu-button[aria-expanded="true"] {
    color: var(--gray-0);
    background: var(--gray-800);
    border-color: var(--gray-600);
  }

  .menu-button[hidden] {
    display: none;
  }

  /* Small-screen: the dropdown hangs below the bar. The panel surface lives
     here rather than on .nav-items, because .socials shares the same panel. */
  #menu-content {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    margin-top: -0.5rem;
    max-height: calc(100dvh - 100%);
    overflow: auto;
    overscroll-behavior: contain;
    z-index: 50;
    background: hsla(var(--gray-999-basis), 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--gray-800);
  }

  .nav-items {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--text-md);
    line-height: 1.2;
    list-style: none;
    padding: 1rem 1.5rem 0.75rem;
  }

  /* Panel seam between the menu and the social row. */
  #menu-content > .socials {
    padding-block: 0.75rem 1.25rem;
    margin-inline: 1.5rem;
    border-top: 1px solid var(--gray-800);
  }

  .link {
    position: relative;
    display: inline-block;
    color: var(--gray-200);
    text-decoration: none;
    transition: color var(--theme-transition);
    font-weight: 500;
  }

  .nav-items .link {
    display: block;
    padding: 0.5rem 0;
    min-height: 24px;
  }

  .link:hover,
  .link:focus-visible {
    color: var(--gray-0);
  }

  .link[aria-current] {
    color: var(--gray-0);
    font-weight: 600;
  }

  @media (max-width: 30em) {
    nav {
      padding-inline: 1rem;
      gap: 0.5rem;
    }

    .site-title {
      font-size: 0.85rem;
      letter-spacing: 0.02em;
    }

    .controls {
      gap: 0.375rem;
    }
  }

  @media (min-width: 50em) {
    nav {
      /* wordmark · links · controls — the links stay optically centred. */
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 1.5rem;
      padding: 2.5rem 2rem;
      margin-bottom: 0;
    }

    .site-title {
      font-size: var(--text-base);
    }

    #menu-content {
      position: static;
      display: contents;
      margin: 0;
      max-height: none;
      overflow: visible;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border: none;
    }

    .nav-items {
      flex-direction: row;
      justify-content: center;
      gap: 0.25rem;
      padding: 0;
      font-size: var(--text-sm);
    }

    /* Panel seam between the socials and the sound/theme pair. */
    .socials::after {
      content: "";
      flex: none;
      width: 1px;
      height: 1.15rem;
      margin-left: 0.4rem;
      background: var(--gray-800);
    }

    #menu-content > .socials {
      border-top: none;
      margin-inline: 0;
      padding: 0;
    }

    .nav-items .link {
      display: inline-block;
      padding: 0.5rem 0.875rem;
      min-height: 0;
    }

    /* Underline indicator instead of a pill: quieter, and the grid reads
       through it. */
    .link::after {
      content: "";
      position: absolute;
      bottom: 0.25rem;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 2px;
      border-radius: 2px;
      background-color: var(--gold);
      transition: width var(--theme-transition) ease-out;
    }

    .link:hover::after,
    .link:focus-visible::after,
    .link[aria-current]::after {
      width: 1.25rem;
    }

    .link:hover,
    .link:focus-visible {
      background-color: transparent;
    }

    .link[aria-current] {
      background-color: transparent;
    }

    .controls {
      justify-self: end;
    }
  }

  @media (min-width: 60em) {
    nav {
      padding: 2.5rem 4rem;
    }
  }

  @media (forced-colors: active) {
    .link[aria-current] {
      color: SelectedItem;
    }
    .link[aria-current]::after {
      background-color: SelectedItem;
    }
  }
</style>
