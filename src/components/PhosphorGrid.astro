---
/**
 * PhosphorGrid — the homepage backdrop.
 * ====================================
 * A full-bleed cell field of individually lit squares, separated by 1px gaps.
 * Mechanic borrowed from shreygups/shreygups, temperament inverted:
 *
 *   theirs  a light wall. Always lit (floor 0.55), 11-stop orange→yellow
 *           palette, 20px cells, covers the whole viewport.
 *   ours    an instrument at rest. Barely lit (floor 0.06), one phosphor hue
 *           in 10 quantised steps, 30px cells, masked to the masthead.
 *
 * Interaction is CLICK-ONLY. A press drops a stone in the pond: one wake point
 * that throws an expanding excitation glow and an expanding front, measured in
 * cells rather than pixels, over cells that then hold and decay — phosphor,
 * not water. Pointer movement does nothing at all. Hover-driven wake was
 * removed deliberately: a field that lights up wherever the cursor happens to
 * rest competes with the words it is behind, and no amount of damping made
 * that worth it. One deliberate gesture reads better than constant chatter.
 *
 * Deliberately NOT wired to the soundtrack. The reference advertises audio
 * reactivity that does not exist (`live.bass = 0.35`, constants); building it
 * for real is easy, but pulsing light driven by a drone is the fastest way to
 * feel cheap, and the field already breathes on its own slow noise.
 *
 * Cost control: device-pixel aligned cells, the noise field is refreshed every
 * fifth frame, and only cells whose brightness bucket actually changed are
 * repainted. With no pointer tracking, a resting page does a handful of
 * fillRects per frame at most — usually none.
 */

interface Props {
  /** Cell pitch in CSS px, including the gap. */
  cell?: number;
  /** Gap between cells in CSS px. The dark seam that reads as a screen. */
  gap?: number;
  /**
   * CSS selector for the elements the field must stay out of the way of.
   * Anything matched gets a soft, geometry-derived quiet zone: excitation is
   * heavily damped there so the field can never become the background behind
   * live text. Derived from their real rects, so it follows the content's
   * silhouette (and its wrapping) instead of boxing it.
   */
  quiet?: string;
  class?: string;
}

const { cell = 30, gap = 1, quiet, class: className } = Astro.props;
---

<div
  class:list={["phosphor-grid", className]}
  style={{
    /* Geometry. Named distinctly from the colour tokens below: these once
       shared the name --pg-cell, and the inline pitch silently shadowed the
       palette, which is a bug that hides well. */
    "--pg-pitch": `${cell}px`,
    "--pg-gap": `${gap}px`,
  }}
  data-quiet={quiet}
  aria-hidden="true"
>
  <canvas data-pg-canvas></canvas>
</div>

<style>
  /* Positioning is the consumer's job (a backdrop layer here, but the
     component must not assume a hero). */
  .phosphor-grid {
    overflow: hidden;
    pointer-events: none;
    /* Ink colours. Light mode prints dark green on bone; dark mode excites
       phosphor on lacquer. */
    --pg-ink: #1b4d31;
    --pg-ink-hot: #0b2116;
    --pg-strength: 0.72;
    /* Fraction of EXCITATION that survives inside the quiet zone. Low enough
       that the field can never become the background behind live text. */
    --pg-quiet: 0.14;
    /* Unitless percent of the grid's height sitting behind the navbar. The
       stylesheet dims the surface over this band and the script damps pointer
       excitation across it, so both stay in step from one number. */
    --pg-nav-band: 13;
  }

  :global(.theme-dark) .phosphor-grid {
    --pg-ink: #8ce07a;
    --pg-ink-hot: #b6f2a4;
    --pg-strength: 1;
    --pg-quiet: 0.26;
  }

  canvas {
    display: block;
    /* Sized in JS to a whole number of cells so no cell is ever clipped
       mid-square — the parent's overflow hides the remainder. */
    width: 100%;
    height: 100%;
  }

  @media (forced-colors: active) {
    .phosphor-grid {
      display: none;
    }
  }
</style>

<script>
  type Ctx = CanvasRenderingContext2D;

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  /* --- Field ------------------------------------------------------------- */

  const hash3 = (x: number, y: number, z: number): number => {
    let n = (Math.imul(x, 374761393) + Math.imul(y, 668265263) + Math.imul(z, 1440662683)) | 0;
    n = Math.imul(n ^ (n >>> 13), 1274126177);
    n ^= n >>> 16;
    return (n >>> 0) / 4294967296;
  };

  const noise3 = (x: number, y: number, z: number): number => {
    const xi = Math.floor(x);
    const yi = Math.floor(y);
    const zi = Math.floor(z);
    const fx = x - xi;
    const fy = y - yi;
    const fz = z - zi;
    const u = fx * fx * (3 - 2 * fx);
    const v = fy * fy * (3 - 2 * fy);
    const w = fz * fz * (3 - 2 * fz);
    const mix = (a: number, b: number, t: number) => a + (b - a) * t;
    const x00 = mix(hash3(xi, yi, zi), hash3(xi + 1, yi, zi), u);
    const x10 = mix(hash3(xi, yi + 1, zi), hash3(xi + 1, yi + 1, zi), u);
    const x01 = mix(hash3(xi, yi, zi + 1), hash3(xi + 1, yi, zi + 1), u);
    const x11 = mix(hash3(xi, yi + 1, zi + 1), hash3(xi + 1, yi + 1, zi + 1), u);
    return mix(mix(x00, x10, v), mix(x01, x11, v), w);
  };

  const fbm = (x: number, y: number, z: number) =>
    0.62 * noise3(x, y, z) + 0.38 * noise3(x * 2.17 + 11.3, y * 2.17 + 7.9, z * 2.17 + 3.1);

  /* --- Tuning ------------------------------------------------------------ */

  const CFG = {
    // Field: slow, large-scale cloud so the resting screen is never static.
    fieldScale: 0.062,
    driftX: 0.016,
    driftY: 0.011,
    evolve: 0.026,
    /** Clamps the low tail of the noise so the field stays sparse. */
    threshold: 0.26,
    gamma: 1.0,
    /**
     * Ceiling of the resting field, as a fraction of `ceiling`. This is the
     * whole "at rest" decision: enough that the screen is visibly a screen,
     * low enough that the headline stays the brightest thing on the page.
     * Tuned so the resting field lands in buckets 0-3 and a full hit lands on
     * 9 — roughly a 6x range between idling and excited.
     */
    floor: 0.3,
    /** The noise field is recomputed every Nth frame, not every frame. */
    fieldEvery: 5,

    // Wake
    wakeMax: 14,
    wakeLife: 1.6,
    wakeDelay: 0.045,
    /** Excitation glow grows this many cells per second. */
    spreadBase: 0.45,
    spreadRate: 1.7,
    /**
     * Excitation gains. Tuned for a click that reads clearly without ever
     * becoming the background: peak energy at the impact lands mid-range, so a
     * ripple is legible on lacquer and harmless behind type.
     */
    glowGain: 0.22,
    /** Front expands this many cells per second. */
    frontSpeed: 7,
    frontWidth: 0.9,
    frontGain: 0.42,
    /** Afterglow decay constant, seconds. Ours; the reference has no hold. */
    holdTau: 1.15,
    /** Cells are clamped here before quantising, so hits can overdrive. */
    ceiling: 1.0,
    buckets: 10,
    /** Excitation falls to this fraction at the very top of the surface. */
    navQuiet: 0.18,
    /** Falloff shape across the navbar band. Above 1 the damping holds on
     *  longer, which matters because brightness is quantised into buckets —
     *  a linear ramp barely moves the peak down a single step. */
    navCurve: 1.6,
    /** Half-width of the quiet zone's skirt, in cells. */
    quietRadius: 2.5,
  };

  /** Alpha per brightness bucket. Bucket 0 is fully unlit. */
  const RAMP = [0, 0.055, 0.09, 0.14, 0.2, 0.28, 0.38, 0.5, 0.64, 0.84];

  /** Clicks landing on one of these are the control's business, not the field's. */
  const INTERACTIVE = "a, button, input, select, textarea, summary, label";

  /** Idle frame gap, ms. ~8fps is plenty for a field this slow. */
  const IDLE_INTERVAL_MS = 125;

  const parseColor = (value: string): [number, number, number] | null => {
    const hex = value.trim();
    const m = /^#?([0-9a-f]{6})$/i.exec(hex);
    if (m) {
      const n = parseInt(m[1], 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    }
    const rgb = /rgba?\(\s*(\d+)[,\s]+(\d+)[,\s]+(\d+)/i.exec(hex);
    if (rgb) return [Number(rgb[1]), Number(rgb[2]), Number(rgb[3])];
    // Never fall back silently: a wrong-but-plausible colour is far harder to
    // spot than a loud one. (This exact silence once masked a token collision
    // that painted the light theme phosphor-green instead of ink.)
    console.warn(`[PhosphorGrid] unparseable colour token: "${hex}"`);
    return null;
  };

  class Grid {
    root: HTMLElement;
    canvas: HTMLCanvasElement;
    ctx: Ctx;

    dpr = 1;
    cols = 0;
    rows = 0;
    cellPx = 0;
    tilePx = 0;

    /** Per-cell retained brightness (the phosphor). */
    energy = new Float32Array(0);
    /** Cached noise field, refreshed every CFG.fieldEvery frames. */
    field = new Float32Array(0);
    /** Last painted bucket per cell, so only changes are repainted. */
    bucket = new Uint8Array(0);

    fills: string[] = [];

    /** Wake points, oldest first; `ws` is each point's strength. */
    wx = new Float32Array(CFG.wakeMax);
    wy = new Float32Array(CFG.wakeMax);
    wt = new Float32Array(CFG.wakeMax);
    ws = new Float32Array(CFG.wakeMax);
    wcount = 0;

    clock = 0;
    frame = 0;
    raf = 0;
    /** Pending idle setTimeout, so `stop()` can cancel the parked loop too. */
    idleTimer = 0;
    last = 0;
    visible = false;
    forceAll = true;

    /* Scratch buffer reused while ageing the wake list. */
    tmpX = new Float32Array(CFG.wakeMax);
    tmpY = new Float32Array(CFG.wakeMax);
    tmpT = new Float32Array(CFG.wakeMax);
    tmpS = new Float32Array(CFG.wakeMax);
    tmpN = 0;

    /** Height of the navbar band, in rows. Set from --pg-nav-band in resize. */
    navBandRows = 0;
    navBandPct = 13;

    /** Selector for elements the field keeps clear of. */
    quietSel = "";
    /** Per-cell 0..1 attenuation, softened. 0 outside the quiet zone. */
    quietGain = new Float32Array(0);
    /** Surviving fraction of excitation inside the zone, from --pg-quiet. */
    quietFloor = 0.2;

    constructor(root: HTMLElement) {
      this.root = root;
      this.quietSel = root.dataset.quiet ?? "";
      this.canvas = root.querySelector<HTMLCanvasElement>("[data-pg-canvas]")!;
      this.ctx = this.canvas.getContext("2d", { alpha: true })!;
      this.readPalette();
      this.resize();
      this.watch();
      this.bindPointer();
    }

    /* --- palette ---------------------------------------------------------- */

    readPalette() {
      const cs = getComputedStyle(this.root);
      const base = parseColor(cs.getPropertyValue("--pg-ink")) ?? [140, 224, 122];
      const hot = parseColor(cs.getPropertyValue("--pg-ink-hot")) ?? base;
      // Dark ink on bone carries far more contrast per unit alpha than
      // phosphor on near-black, so the light theme is dialled back.
      const strength = Number(cs.getPropertyValue("--pg-strength")) || 1;
      const navBand = Number(cs.getPropertyValue("--pg-nav-band"));
      this.navBandPct = Number.isFinite(navBand) && navBand > 0 ? navBand : 13;
      const quiet = Number(cs.getPropertyValue("--pg-quiet"));
      this.quietFloor = Number.isFinite(quiet) && quiet >= 0 ? quiet : 0.2;
      const n = CFG.buckets;
      this.fills = [];
      for (let b = 0; b < n; b++) {
        const t = b / (n - 1);
        const r = Math.round(base[0] + (hot[0] - base[0]) * t);
        const g = Math.round(base[1] + (hot[1] - base[1]) * t);
        const bl = Math.round(base[2] + (hot[2] - base[2]) * t);
        const a = Math.min(1, RAMP[b] * strength);
        this.fills.push(`rgba(${r},${g},${bl},${a})`);
      }
      this.forceAll = true;
    }

    /* --- geometry --------------------------------------------------------- */

    resize() {
      const rect = this.root.getBoundingClientRect();
      if (!rect.width || !rect.height) return;

      // Narrow viewports get a lower pixel density: the 1px seam still reads,
      // and a 60fps full-bleed canvas is expensive on phone-class GPUs.
      const cap = window.matchMedia("(min-width: 50em)").matches ? 2 : 1.5;
      this.dpr = Math.min(window.devicePixelRatio || 1, cap);
      const cell =
        parseFloat(getComputedStyle(this.root).getPropertyValue("--pg-pitch")) || 30;
      const gapCss = parseFloat(getComputedStyle(this.root).getPropertyValue("--pg-gap")) || 1;

      // Whole cells only, rounded up; the parent's overflow clips the excess.
      this.cols = Math.max(1, Math.ceil(rect.width / cell));
      this.rows = Math.max(1, Math.ceil(rect.height / cell));

      const cssW = this.cols * cell;
      const cssH = this.rows * cell;
      this.canvas.style.width = `${cssW}px`;
      this.canvas.style.height = `${cssH}px`;
      this.canvas.width = Math.round(cssW * this.dpr);
      this.canvas.height = Math.round(cssH * this.dpr);

      const gapPx = Math.max(1, Math.round(gapCss * this.dpr));
      this.cellPx = Math.round(cell * this.dpr);
      this.tilePx = Math.max(2, this.cellPx - gapPx);

      const n = this.cols * this.rows;
      this.energy = new Float32Array(n);
      this.field = new Float32Array(n);
      this.bucket = new Uint8Array(n);
      this.navBandRows = (this.rows * this.navBandPct) / 100;
      this.wcount = 0;
      this.clock = 0;
      this.frame = 0;
      this.forceAll = true;
      this.buildQuiet();
      this.computeField();
      this.paintAll();
    }

    /**
     * Rasterise the quiet zone from the real geometry of the protected
     * elements. Built from their bounding rects rather than a hand-tuned
     * region, so it tracks wrapping, breakpoints and the chip row without
     * anyone maintaining a magic rectangle.
     *
     * The falloff is an exact distance field, not a blur. Blurring a mask
     * dilutes its core in proportion to how small the shape is, which left the
     * 15px-tall kicker at barely half protection while the 89px headline was
     * fine. A distance field is full strength everywhere inside the rect and
     * falls off smoothly outside over `quietRadius` cells — so short lines get
     * the same guarantee as tall ones, and the rounded skirt means no box edge
     * ever becomes visible.
     */
    buildQuiet() {
      const n = this.cols * this.rows;
      this.quietGain = new Float32Array(n);
      if (!this.quietSel) return;
      const root = this.root.getBoundingClientRect();
      const pitch = this.cellPx / this.dpr;
      if (!pitch) return;

      const R = CFG.quietRadius;
      for (const el of document.querySelectorAll(this.quietSel)) {
        const r = el.getBoundingClientRect();
        if (!r.width || !r.height) continue;
        // Rect in cell units, then padded by the skirt radius.
        const x0 = (r.left - root.left) / pitch;
        const x1 = (r.right - root.left) / pitch;
        const y0 = (r.top - root.top) / pitch;
        const y1 = (r.bottom - root.top) / pitch;
        const i0 = Math.max(0, Math.floor(x0 - R));
        const i1 = Math.min(this.cols - 1, Math.ceil(x1 + R));
        const j0 = Math.max(0, Math.floor(y0 - R));
        const j1 = Math.min(this.rows - 1, Math.ceil(y1 + R));

        for (let j = j0; j <= j1; j++) {
          const cy = j + 0.5;
          const dy = cy < y0 ? y0 - cy : cy > y1 ? cy - y1 : 0;
          const row = j * this.cols;
          for (let i = i0; i <= i1; i++) {
            const cx = i + 0.5;
            const dx = cx < x0 ? x0 - cx : cx > x1 ? cx - x1 : 0;
            const d = Math.hypot(dx, dy);
            if (d >= R) continue;
            const t = 1 - d / R;
            const q = t * t * (3 - 2 * t); // smoothstep shoulder
            const k = row + i;
            if (q > this.quietGain[k]) this.quietGain[k] = q;
          }
        }
      }
    }

    /* --- field ------------------------------------------------------------ */

    computeField() {
      const { fieldScale, driftX, driftY, evolve, threshold, gamma, floor } = CFG;
      const t = this.clock;
      const ox = t * driftX;
      const oy = t * driftY;
      const oz = t * evolve + 47.1;
      for (let j = 0; j < this.rows; j++) {
        const y = j * fieldScale + oy;
        for (let i = 0; i < this.cols; i++) {
          let b = fbm(i * fieldScale + ox, y, oz);
          b = (b - threshold) / (1 - threshold);
          b = b < 0 ? 0 : Math.pow(b, gamma);
          this.field[j * this.cols + i] = floor * (b > 1 ? 1 : b);
        }
      }
    }

    /* --- pointer ---------------------------------------------------------- */

    bindPointer() {
      // One gesture, one ripple. The surface sits behind everything and is
      // pointer-events:none, so this listens at the document and maps the
      // press into canvas space; anything outside the field is ignored.
      //
      // Clicks on links and controls are skipped: they have their own job, and
      // a ripple under the theme toggle reads as a misfire rather than
      // feedback.
      document.addEventListener(
        "pointerdown",
        (e: PointerEvent) => {
          if (e.target instanceof Element && e.target.closest(INTERACTIVE)) return;
          const rect = this.root.getBoundingClientRect();
          this.ripple(e.clientX - rect.left, e.clientY - rect.top);
        },
        { passive: true },
      );
    }

    /** Drop a ripple at a point, in canvas CSS pixels. */
    ripple(cssX: number, cssY: number) {
      if (reduceMotion.matches) return;
      const pitch = this.cellPx / this.dpr;
      const x = cssX / pitch;
      const y = cssY / pitch;
      if (x < 0 || y < 0 || x >= this.cols || y >= this.rows) return;

      if (this.wcount === CFG.wakeMax) {
        // Drop the oldest by shifting in place.
        this.wx.copyWithin(0, 1);
        this.wy.copyWithin(0, 1);
        this.wt.copyWithin(0, 1);
        this.ws.copyWithin(0, 1);
        this.wcount--;
      }
      this.wx[this.wcount] = x;
      this.wy[this.wcount] = y;
      this.wt[this.wcount] = this.clock;
      // The navbar sits over the top band, so excitation is damped there: nav
      // labels must never have to compete with cells lighting up behind them.
      const band = this.navBandRows;
      this.ws[this.wcount] =
        y < band
          ? CFG.navQuiet + (1 - CFG.navQuiet) * Math.pow(y / band, CFG.navCurve)
          : 1;
      this.wcount++;
      this.wake();
    }

    /* --- loop ------------------------------------------------------------- */

    watch() {
      new IntersectionObserver(
        ([entry]) => {
          this.visible = entry.isIntersecting;
          if (this.visible) this.wake();
          else this.stop();
        },
        { threshold: 0 },
      ).observe(this.root);

      const ro = new ResizeObserver(() => this.resize());
      ro.observe(this.root);

      // Webfonts land after first paint and move the text; the quiet zone is
      // measured from real rects, so it has to be re-measured once they do.
      document.fonts?.ready.then(() => {
        this.buildQuiet();
        this.forceAll = true;
        this.paintAll();
        this.wake();
      });

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) this.stop();
        else if (this.visible) this.wake();
      });

      new MutationObserver(() => {
        this.readPalette();
        this.computeField();
        this.paintAll();
        this.wake();
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
      });

      reduceMotion.addEventListener("change", () => {
        if (reduceMotion.matches) {
          this.stop();
          this.computeField();
          this.paintAll();
        } else {
          this.wake();
        }
      });
    }

    wake() {
      if (!this.visible || document.hidden || reduceMotion.matches) return;
      if (this.raf) return; // already drawing this frame
      // Parked on the idle timer: a ripple just landed, so come back now rather
      // than at the next idle tick.
      if (this.idleTimer) {
        clearTimeout(this.idleTimer);
        this.idleTimer = 0;
      }
      this.raf = requestAnimationFrame(this.tick);
    }

    stop() {
      if (this.raf) cancelAnimationFrame(this.raf);
      if (this.idleTimer) clearTimeout(this.idleTimer);
      this.raf = 0;
      this.idleTimer = 0;
    }

    tick = (now: number) => {
      this.raf = 0;
      // Exponential decay is unconditionally stable, so the real elapsed time
      // can be used directly. Clamping hard at one frame would make the
      // afterglow run in slow motion whenever the page idles at a low frame
      // rate. The generous clamp only guards against a suspended tab.
      const dt = this.last ? Math.min(0.5, (now - this.last) / 1000) : 0;
      this.last = now;
      this.clock += dt;
      this.frame++;

      if (this.frame % CFG.fieldEvery === 0) this.computeField();

      // Age the wake list.
      const { wakeLife } = CFG;
      let n = 0;
      for (let w = 0; w < this.wcount; w++) {
        if (this.clock - this.wt[w] <= wakeLife) {
          this.tmpX[n] = this.wx[w];
          this.tmpY[n] = this.wy[w];
          this.tmpT[n] = this.wt[w];
          this.tmpS[n] = this.ws[w];
          n++;
        }
      }
      this.wx.set(this.tmpX.subarray(0, n));
      this.wy.set(this.tmpY.subarray(0, n));
      this.wt.set(this.tmpT.subarray(0, n));
      this.ws.set(this.tmpS.subarray(0, n));
      this.wcount = n;

      // Age the phosphor: this is the part the reference does not have.
      const decay = Math.exp(-dt / CFG.holdTau);
      const energy = this.energy;
      for (let k = 0; k < energy.length; k++) {
        energy[k] = energy[k] > 0.004 ? energy[k] * decay : 0;
      }

      if (n) this.excite();

      this.render();

      // Nothing is chasing the pointer any more, so once the last ripple has
      // faded the only reason to keep drawing is the field's own drift — which
      // is slower than a glacier. Drop to a crawl and give the CPU back.
      // `dt` is real elapsed time, so the drift rate is unaffected.
      this.raf = n
        ? requestAnimationFrame(this.tick)
        : (this.idleTimer = window.setTimeout(() => {
            this.idleTimer = 0;
            this.raf = requestAnimationFrame(this.tick);
          }, IDLE_INTERVAL_MS));
    };

    /** Write excitation + expanding front from every live wake point. */
    excite() {
      const { spreadBase, spreadRate, glowGain, frontSpeed, frontWidth, frontGain, ceiling } = CFG;
      const e = this.energy;
      for (let w = 0; w < this.wcount; w++) {
        const strength = this.ws[w];
        if (strength <= 0.01) continue;
        const delayed = this.clock - this.wt[w] - CFG.wakeDelay;
        if (delayed < 0) continue;
        const life = 1 - delayed / CFG.wakeLife;
        if (life <= 0) continue;
        const fade = life * life * strength;

        const spread = spreadBase + delayed * spreadRate;
        const spreadInv = 1 / (spread * spread * 0.42);
        const front = delayed * frontSpeed;
        const wInv = 1 / (frontWidth * frontWidth);

        const cx = this.wx[w];
        const cy = this.wy[w];
        // Bounding box: glow reaches ~2.5 spreads, plus the front's radius.
        const reach = Math.max(spread * 2.6, front + frontWidth * 3) + 1;
        const i0 = Math.max(0, Math.floor(cx - reach));
        const i1 = Math.min(this.cols - 1, Math.ceil(cx + reach));
        const j0 = Math.max(0, Math.floor(cy - reach));
        const j1 = Math.min(this.rows - 1, Math.ceil(cy + reach));

        for (let j = j0; j <= j1; j++) {
          const dy = j - cy;
          const row = j * this.cols;
          for (let i = i0; i <= i1; i++) {
            const dx = i - cx;
            const d2 = dx * dx + dy * dy;
            const glow = glowGain * Math.exp(-d2 * spreadInv);
            const ring = Math.sqrt(d2) - front;
            const wave = frontGain * Math.exp(-(ring * ring) * wInv);
            const v = fade * (glow + wave);
            const k = row + i;
            if (v > e[k]) e[k] = Math.min(ceiling, v);
          }
        }
      }
    }

    /* --- paint ------------------------------------------------------------ */

    bucketOf(v: number) {
      const t = v >= CFG.ceiling ? 1 : v / CFG.ceiling;
      const b = (t * (CFG.buckets - 1) + 0.5) | 0;
      return b < 0 ? 0 : b >= CFG.buckets ? CFG.buckets - 1 : b;
    }

    paintAll() {
      const ctx = this.ctx;
      const n = this.cols * this.rows;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      for (let k = 0; k < n; k++) this.paintCell(k, this.bucketOf(this.valueAt(k)));
      this.forceAll = false;
    }

    paintCell(k: number, b: number) {
      const ctx = this.ctx;
      const x = (k % this.cols) * this.cellPx;
      const y = ((k / this.cols) | 0) * this.cellPx;
      // Always clear the cell first.
      //
      // Source-over compositing means painting a DIMMER colour over a brighter
      // one adds opacity rather than reducing it — and painting a fully
      // transparent colour does nothing at all. Without this clear the field is
      // one-way: every repaint can only make a cell brighter, so ripples never
      // fade, the quiet zone never actually dims anything behind text, and the
      // whole surface creeps toward white over a session.
      ctx.clearRect(x, y, this.cellPx, this.cellPx);
      this.bucket[k] = b;
      if (b === 0) return; // unlit: the cleared gap is the correct end state
      ctx.fillStyle = this.fills[b];
      ctx.fillRect(x, y, this.tilePx, this.tilePx);
    }

    /**
     * Effective cell brightness: the resting field plus whatever excitation is
     * still held, both cut back inside the quiet zone. One function so the
     * full repaint and the incremental repaint can never disagree about what a
     * cell should look like.
     */
    valueAt(k: number): number {
      const q = this.quietGain[k];
      if (q === 0) return this.field[k] + this.energy[k];
      // ONLY excitation is damped; the resting field is left completely alone.
      //
      // Cutting the resting field as well would carve a permanently lighter
      // (light theme) or darker (dark theme) rectangle behind the words even
      // when nothing is happening — the exact pasted-on-panel look this zone
      // exists to avoid. It also isn't needed: at rest the field tops out
      // around bucket 2, which every hero text colour already clears AA
      // against. So the zone stays completely invisible when idle and only
      // shows as the ripple losing energy near the words.
      return this.field[k] + this.energy[k] * (1 - q * (1 - this.quietFloor));
    }

    render() {
      const { bucket } = this;
      const n = this.field.length;
      for (let k = 0; k < n; k++) {
        const b = this.bucketOf(this.valueAt(k));
        if (b !== bucket[k]) this.paintCell(k, b);
      }
    }
  }

  const boot = () => {
    for (const el of document.querySelectorAll<HTMLElement>(".phosphor-grid")) {
      if (!el.dataset.ready) {
        el.dataset.ready = "1";
        new Grid(el);
      }
    }
  };

  boot();
  document.addEventListener("astro:page-load", boot);
</script>
