---
// Learn about using Astro layouts:
// https://docs.astro.build/en/core-concepts/layouts/

// Component Imports
import MainHead from "../components/MainHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Aurora from "../components/Aurora.astro";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  /** Render the aurora glow at the top of the page. Defaults to true. */
  aurora?: boolean;
}

const { title, description, aurora = true } = Astro.props;
---

<html lang="en">
  <head>
    <MainHead title={title} description={description} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <!-- Ambient bed. `transition:persist` keeps this exact media element (and
         its playback position) alive across ClientRouter navigations, so the
         soundtrack survives page changes instead of restarting.
         preload="none": nothing is fetched until sound is switched on. -->
    <audio id="site-audio" preload="none" loop transition:persist>
      <source src="/audio/ambient-432hz.webm" type="audio/webm" />
      <source src="/audio/ambient-432hz.m4a" type="audio/mp4" />
    </audio>
    <!-- Aurora hero section wrapper -->
    {
      aurora && (
        <div class="aurora-hero-wrapper">
          <Aurora
            colorStopsLight={["#f7f1e2", "#e8dcc0", "#dcd3ba"]}
            colorStopsDark={["#00a152", "#00e676", "#004d27"]}
            amplitude={0.5}
            blend={0.8}
            speed={0.4}
          />
        </div>
      )
    }
    <div class="stack backgrounds">
      <Nav />
      <slot />
      <Footer />
    </div>

    <script>
      // Add "loaded" class once the document has completely loaded.
      addEventListener("load", () =>
        document.documentElement.classList.add("loaded"),
      );
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -100px;
        z-index: 100;
      }
      .skip-link:focus-visible {
        top: 1rem;
      }

      #site-audio {
        display: none;
      }

      /* Aurora container - subtle accent at the top only */
      .aurora-hero-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 50vh;
        min-height: 300px;
        max-height: 600px;
        overflow: hidden;
        z-index: 0;
        pointer-events: none;
        /* Warm light spill in light mode; a lit panel, not a green stain. */
        opacity: 0.34;
        /* Dynamic radial fade out for premium unique blending */
        mask-image: radial-gradient(ellipse at top, black 0%, transparent 80%);
        -webkit-mask-image: radial-gradient(ellipse at top, black 0%, transparent 80%);
      }

      :global(.theme-dark) .aurora-hero-wrapper {
        opacity: 0.3; /* Keep it exceedingly subtle in dark mode */
      }

      @media (min-width: 50em) {
        .aurora-hero-wrapper {
          height: 60vh;
          max-height: 800px;
          mask-image: radial-gradient(ellipse at top, black 0%, transparent 70%);
          -webkit-mask-image: radial-gradient(ellipse at top, black 0%, transparent 70%);
        }
      }

      .backgrounds {
        min-height: 100%;
        position: relative;
        z-index: 1;
        background-color: transparent;
      }

      /* Noise overlay on the aurora section */
      /* .aurora-hero-wrapper::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: url("/assets/backgrounds/noise.png") top center/220px repeat;
        opacity: 0.1;
        mix-blend-mode: overlay;
      } */

      @media (forced-colors: active) {
        .aurora-hero-wrapper {
          display: none;
        }
      }
    </style>
  </body>
</html>
