---
import BaseLayout from "../layouts/BaseLayout.astro";

import ContactCTA from "../components/ContactCTA.astro";

import { Image } from "astro:assets";
import aboutPic from "../assets/portrait.png";

/**
 * Capability rows. Kept as data rather than five hand-written blocks so the
 * list stays easy to extend and the markup stays identical row to row.
 */
const skills = [
  {
    label: "Programming Languages",
    items: ["Golang", "TypeScript", "JavaScript", "Python"],
  },
  {
    label: "Frameworks & Runtimes",
    items: ["Node.js", "Deno", "Bun", "Hono", "React"],
  },
  {
    label: "Cloud & DevOps",
    items: [
      "AWS",
      "Google Cloud Platform",
      "Docker",
      "Cloudflare Workers",
      "CI/CD",
      "GitHub Actions",
    ],
  },
  {
    label: "Databases",
    items: ["MongoDB", "PostgreSQL", "MySQL", "Redis", "RabbitMQ"],
  },
  {
    label: "Interests",
    items: [
      "Cloud-Native Technologies",
      "Information Security",
      "AI/ML",
      "API Integration",
    ],
  },
];
---

<BaseLayout
  title="About Me | Kuldeep Parmar"
  description="About Kuldeep Parmar"
>
  <div class="stack gap-20 lg:gap-48">
    <main id="main-content" tabindex="-1" class="wrapper dossier">
      <!-- ================================================================
           Identity — the specimen plate and its legend.
           The portrait is mounted the way the homepage mounts its monogram:
           a lacquer backing, an inlaid gold hairline, an engraved caption.
           ================================================================ -->
      <section class="identity">
        <figure class="portrait">
          <div class="portrait__plate">
            <div class="portrait__frame">
              <Image
                src={aboutPic}
                widths={[240, 540, 720, aboutPic.width]}
                sizes={`(max-width: 360px) 240px, (max-width: 640px) 540px, (max-width: 900px) 720px, ${aboutPic.width}px`}
                alt="Kuldeep Parmar profile picture"
                loading={"eager"}
              />
            </div>
            <span class="portrait__seal" aria-hidden="true">KP</span>
          </div>

          <figcaption class="portrait__caption">
            <span class="portrait__model">KP-01</span>
            <span class="portrait__ticks"></span>
          </figcaption>
        </figure>

        <div class="identity__legend">
          <span class="stripe" aria-hidden="true"
            ><span></span><span></span><span></span></span
          >
          <h1 class="identity__title">
            <span class="identity__kicker">About Me</span>
            <span class="identity__name">Kuldeep Parmar</span>
          </h1>
          <p class="identity__tagline">
            Learn more about my background and experience below.
          </p>
        </div>
      </section>

      <!-- 01 · Background -->
      <section class="entry" aria-labelledby="entry-background">
        <span class="entry__rule" aria-hidden="true"></span>
        <header class="entry__head">
          <p class="entry__index" aria-hidden="true">01</p>
          <h2 id="entry-background" class="entry__title">Background</h2>
        </header>
        <div class="entry__body prose">
          <p class="prose__lead">
            I'm a passionate software developer with strong problem-solving
            skills and deep interest in the ever-growing world of cloud-native
            tech. I focus on creating innovative solutions by embedding
            intelligence into applications.
          </p>
          <p>
            My experience spans backend systems, cloud infrastructure, and
            process automation. I prioritize information security, ensuring the
            applications I develop are robust, secure, and user-friendly. By
            leveraging the latest AI tools and continuously adapting to new
            challenges, I deliver solutions that blend technical excellence with
            a seamless user experience.
          </p>
          <p>
            I'm always willing to work remotely with teams to embrace new
            challenges and achieve success.
          </p>
        </div>
      </section>

      <!-- 02 · Education — one credential, so it gets one made object rather
           than a heading with an orphaned line under it. -->
      <section class="entry" aria-labelledby="entry-education">
        <span class="entry__rule" aria-hidden="true"></span>
        <header class="entry__head">
          <p class="entry__index" aria-hidden="true">02</p>
          <h2 id="entry-education" class="entry__title">Education</h2>
        </header>
        <div class="entry__body">
          <article class="record">
            <span class="record__lamp" aria-hidden="true"></span>
            <div class="record__main">
              <h3 class="record__org">Atmiya University</h3>
              <p class="record__qual">
                Bachelor of Science in Information Technology
              </p>
            </div>
            <p class="record__years tabular">
              <time datetime="2019">2019</time>
              <span class="record__dash" aria-hidden="true"></span>
              <time datetime="2022">2022</time>
            </p>
          </article>
        </div>
      </section>

      <!-- 03 · AI-driven development — the claim, stated before the tool
           list. Reuses the Background prose pattern; two sentences do not
           need a layout of their own. -->
      <section class="entry" aria-labelledby="entry-ai">
        <span class="entry__rule" aria-hidden="true"></span>
        <header class="entry__head">
          <p class="entry__index" aria-hidden="true">03</p>
          <h2 id="entry-ai" class="entry__title">AI-Driven Development</h2>
        </header>
        <div class="entry__body prose">
          <p class="prose__lead">
            I'm proficient with AI-driven development. I run coding agents
            daily, and I'm at my best in codebases I've never seen — especially
            the ones that have been aging for a while.
          </p>
          <p>
            The agents carry the slow, mechanical work. The architecture, the
            design calls, and the code that ships stay with me.
          </p>
        </div>
      </section>

      <!-- 04 · Skills — a definition list, because that is what a spec sheet
           is: term, then values. -->
      <section class="entry" aria-labelledby="entry-skills">
        <span class="entry__rule" aria-hidden="true"></span>
        <header class="entry__head">
          <p class="entry__index" aria-hidden="true">04</p>
          <h2 id="entry-skills" class="entry__title">Skills</h2>
        </header>
        <div class="entry__body">
          <dl class="matrix">
            {
              skills.map(({ label, items }) => (
                <div class="matrix__row">
                  <dt class="matrix__key">{label}</dt>
                  <dd class="matrix__values">
                    {items.map((item) => (
                      <span class="matrix__chip">{item}</span>
                    ))}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  /* ======================================================================
     Page shell
     Entries are two columns: a sticky label rail and the content. The rail
     is what keeps the page from reading as one centred column of prose, and
     it gives every section a scannable anchor.
     ====================================================================== */
  .dossier {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 9vw, 7.5rem);
  }

  /* --- Identity --------------------------------------------------------- */
  .identity {
    display: grid;
    gap: clamp(2.25rem, 5vw, 3.5rem);
    align-items: center;
  }

  .stripe {
    display: flex;
    gap: 0.3rem;
    width: fit-content;
    margin-bottom: 1.25rem;
  }

  .stripe span {
    height: 0.5rem;
    background: var(--gold);
    transform: skewX(-20deg);
  }

  .stripe span:nth-child(1) {
    width: clamp(1.9rem, 8vw, 2.6rem);
  }
  .stripe span:nth-child(2) {
    width: clamp(0.85rem, 3.6vw, 1.15rem);
  }
  .stripe span:nth-child(3) {
    width: clamp(0.38rem, 1.6vw, 0.52rem);
  }

  .identity__legend {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    text-align: center;
  }

  .identity__title {
    display: grid;
    gap: 0.35rem;
    justify-items: center;
  }

  .identity__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--gray-400);
    text-shadow: var(--engrave);
  }

  .identity__name {
    font-size: var(--text-display);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.94;
    color: var(--gray-0);
    text-shadow: var(--engrave);
  }

  .identity__tagline {
    max-width: 40ch;
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--gray-300);
    text-wrap: pretty;
  }

  /* --- The portrait plate -----------------------------------------------
     Mounted, not just placed: lacquer backing, inlaid gold hairline, an
     engraved caption strip underneath, and a die-struck monogram seal
     overlapping the frame — the same hardware the homepage plate uses. */
  .portrait {
    margin: 0;
    display: grid;
    gap: 0.85rem;
    width: 100%;
    max-width: 26rem;
    justify-self: center;
  }

  .portrait__plate {
    position: relative;
  }

  .portrait__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 1rem;
    /* Lacquer, lit from the top-left like every other surface on the site. */
    background: radial-gradient(
      130% 100% at 24% -8%,
      var(--lacquer-lit) 0%,
      var(--lacquer) 40%,
      var(--lacquer-deep) 100%
    );
    box-shadow:
      inset 0 1px 0 hsla(110, 45%, 82%, 0.2),
      inset 0 0 0 1px hsla(150, 45%, 3%, 0.5),
      var(--shadow-lg);
  }

  :global(:root:not(.theme-dark)) .portrait__frame {
    background: radial-gradient(
      130% 100% at 24% -8%,
      var(--bone-hi) 0%,
      var(--bone) 44%,
      var(--bone-dim) 100%
    );
    box-shadow:
      inset 0 1px 0 hsla(0, 0%, 100%, 0.9),
      inset 0 0 0 1px hsla(43, 20%, 58%, 0.38),
      var(--shadow-lg);
  }

  .portrait__frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Just above the eyes' line: keeps the head clear of the top edge
       without cropping the shoulders out of the frame. */
    object-position: 50% 16%;
  }

  /* Inlaid gold hairline, matching the homepage plate. */
  .portrait__frame::after {
    content: "";
    position: absolute;
    inset: 0.6rem;
    pointer-events: none;
    border: 1px solid hsla(43, 42%, 58%, 0.3);
    border-radius: 0.6rem;
    box-shadow:
      inset 0 1px 0 hsla(43, 55%, 82%, 0.16),
      0 1px 0 hsla(150, 45%, 3%, 0.35);
  }

  :global(:root:not(.theme-dark)) .portrait__frame::after {
    border-color: hsla(43, 45%, 34%, 0.32);
    box-shadow:
      inset 0 1px 0 hsla(43, 60%, 94%, 0.6),
      0 1px 0 hsla(0, 0%, 100%, 0.55);
  }

  /* Die-struck monogram, overlapping the frame's lower-right corner. */
  .portrait__seal {
    position: absolute;
    right: -0.7rem;
    bottom: -0.7rem;
    display: grid;
    place-items: center;
    width: 3.1rem;
    aspect-ratio: 1;
    border-radius: 50%;
    font-family: var(--font-brand);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.04em;
    color: #241a05;
    background: radial-gradient(
      circle at 34% 26%,
      var(--gold-hi) 0%,
      var(--gold) 32%,
      var(--gold) 56%,
      var(--gold-lo) 100%
    );
    box-shadow:
      inset 1px 1px 1px hsla(40, 65%, 94%, 0.6),
      inset -2px -3px 5px hsla(40, 55%, 20%, 0.5),
      0 1px 0 hsla(150, 45%, 3%, 0.5),
      0 6px 14px -6px hsla(150, 45%, 3%, 0.7);
    text-shadow: 0 1px 0 hsla(40, 70%, 92%, 0.72);
  }

  :global(:root:not(.theme-dark)) .portrait__seal {
    box-shadow:
      inset 1px 1px 1px hsla(40, 65%, 96%, 0.7),
      inset -2px -3px 5px hsla(40, 50%, 26%, 0.4),
      0 1px 0 hsla(0, 0%, 100%, 0.8),
      0 6px 14px -6px hsla(43, 30%, 35%, 0.35);
  }

  .portrait__caption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .portrait__model {
    flex: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--gold-ink);
    text-shadow: var(--engrave);
  }

  /* Etched scale. The portrait's own background is a wall of vertical slats,
     so a measuring rule directly beneath it continues that rhythm rather
     than being a decorative afterthought. */
  .portrait__ticks {
    flex: 1;
    height: 8px;
    background-image:
      repeating-linear-gradient(90deg, var(--tick) 0 1px, transparent 1px 44px),
      repeating-linear-gradient(90deg, var(--tick) 0 1px, transparent 1px 11px);
    background-size:
      100% 100%,
      30% 100%;
    background-repeat: no-repeat, repeat;
  }

  /* --- Entry (section) -------------------------------------------------- */
  .entry {
    display: grid;
    gap: 1.5rem 2.5rem;
  }

  .entry__rule {
    grid-column: 1 / -1;
    height: 8px;
    background-image:
      repeating-linear-gradient(90deg, var(--tick) 0 1px, transparent 1px 44px),
      repeating-linear-gradient(90deg, var(--tick) 0 1px, transparent 1px 11px);
    background-size:
      100% 100%,
      12% 100%;
    background-repeat: no-repeat, repeat;
  }

  .entry__head {
    display: grid;
    gap: 0.3rem;
    /* Grid items stretch to fill their row by default, which would make the
       head as tall as the whole section — and a full-height sticky box has
       nothing left to stick. */
    align-self: start;
    align-content: start;
  }

  .entry__index {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--gold-ink);
    text-shadow: var(--engrave);
  }

  .entry__title {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    color: var(--gray-0);
    text-shadow: var(--engrave);
  }

  /* --- Background prose ------------------------------------------------- */
  .prose {
    display: grid;
    gap: 1.15rem;
    max-width: 62ch;
  }

  .prose p {
    font-size: var(--text-md);
    line-height: 1.68;
    color: var(--gray-200);
  }

  /* The first paragraph is the thesis; give it the weight to say so. */
  .prose__lead {
    font-size: var(--text-lg) !important;
    line-height: 1.55 !important;
    color: var(--gray-100) !important;
  }

  /* --- Education record ------------------------------------------------- */
  .record {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.35rem 1rem;
    padding: clamp(1.25rem, 3vw, 1.85rem);
    border: 1px solid var(--surface-raised-border);
    border-radius: 1rem;
    background-color: var(--surface-raised);
    box-shadow: var(--bevel-raised), var(--shadow-sm);
  }

  .record__lamp {
    grid-row: 1 / 3;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--phosphor);
    box-shadow:
      0 0 0 1px hsla(0, 0%, 0%, 0.25),
      0 0 7px 1px color-mix(in srgb, var(--phosphor) 50%, transparent);
  }

  .record__org {
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
    color: var(--gray-0);
  }

  .record__qual {
    grid-column: 2;
    font-size: var(--text-md);
    color: var(--gray-300);
    text-wrap: pretty;
  }

  .record__years {
    grid-column: 2;
    margin-top: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--gray-0);
  }

  .record__dash {
    width: 1.5rem;
    height: 1px;
    background: var(--gold);
    opacity: 0.7;
  }

  /* --- Skills matrix ---------------------------------------------------- */
  .matrix {
    margin: 0;
    display: grid;
  }

  .matrix__row {
    display: grid;
    gap: 0.6rem;
    padding-block: 1.35rem;
    border-top: 1px solid var(--gray-800);
  }

  .matrix__row:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .matrix__key {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--gray-400);
    text-shadow: var(--engrave);
  }

  .matrix__values {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  /* Spec values, not badges: raised keys on the panel, sized so a dense row
     still scans as a list rather than a tag cloud. */
  .matrix__chip {
    padding: 0.28rem 0.6rem;
    border: 1px solid var(--surface-raised-border);
    border-radius: 0.3rem;
    background-color: var(--surface-raised);
    box-shadow: var(--bevel-raised);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--gray-100);
    white-space: nowrap;
  }

  /* ======================================================================
     Wide layout
     ====================================================================== */
  @media (min-width: 56em) {
    .identity {
      grid-template-columns: minmax(0, 38%) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }

    .portrait {
      justify-self: start;
      /* Gutter for the vertical rule that mirrors the photo's slats. */
      padding-left: 1.5rem;
    }

    /* Vertical continuation of the portrait's own vertical rhythm. */
    .portrait::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      bottom: 3.5rem;
      width: 9px;
      background-image:
        repeating-linear-gradient(180deg, var(--tick) 0 1px, transparent 1px 44px),
        repeating-linear-gradient(180deg, var(--tick) 0 1px, transparent 1px 11px);
      background-size:
        100% 100%,
        58% 100%;
      background-repeat: no-repeat, repeat;
    }

    .portrait {
      position: relative;
    }

    .identity__legend {
      justify-items: start;
      text-align: start;
      gap: 0.9rem;
    }

    .identity__title {
      justify-items: start;
    }

    .identity__tagline {
      max-width: 36ch;
      font-size: var(--text-lg);
    }

    .portrait__frame {
      border-radius: 1.15rem;
    }

    /* Label rail beside the content; sticks while its section is in view. */
    .entry {
      grid-template-columns: minmax(0, 12.5rem) minmax(0, 1fr);
      gap: 2.5rem 3.5rem;
    }

    .entry__head {
      position: sticky;
      top: 2.5rem;
    }

    /* Key rail beside its values, so rows line up as a table and short rows
       stop reading as empty space. */
    .matrix__row {
      grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
      gap: 0.35rem 2rem;
      align-items: baseline;
      padding-block: 1.5rem;
    }

    .matrix__row:first-child {
      padding-top: 0;
    }

    .record {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.4rem 1.25rem;
    }

    .record__lamp {
      grid-row: 1 / 3;
    }

    .record__qual {
      grid-column: 2;
    }

    /* Year reads as the record's value column, on its own line. */
    .record__years {
      grid-column: 3;
      grid-row: 1 / 3;
      margin-top: 0;
    }

    .record__dash {
      width: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .entry__head {
      position: static;
    }
  }
</style>
