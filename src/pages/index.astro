---
import { getCollection } from "astro:content";

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Component Imports
import CallToAction from "../components/CallToAction.astro";
import Grid from "../components/Grid.astro";
import Icon from "../components/Icon.astro";
import PhosphorGrid from "../components/PhosphorGrid.astro";
import Pill from "../components/Pill.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";

// Page section components
import ContactCTA from "../components/ContactCTA.astro";
import Skills from "../components/Skills.astro";

// Content Fetching: List four most recent work projects
const projects = (await getCollection("work"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/
---

{/* The grid is the homepage's backdrop, so the aurora stands down here —
    two ambient effects chasing the same job made both read as noise. */}
<BaseLayout aurora={false}>
  <div class="stack gap-20 lg:gap-48">
    <main id="main-content" tabindex="-1" class="stack gap-20 lg:gap-48">
      <div class="stack gap-8 lg:gap-20">
        <!-- The grid is the backdrop, not a component in a column: it spans
             the viewport while the masthead stays inside the wrapper. -->
        <section class="hero-field">
          <PhosphorGrid class="hero-grid" />
          <div class="hero-field__fade" aria-hidden="true"></div>

          <header class="masthead wrapper">
            <span class="stripe" aria-hidden="true"
              ><span></span><span></span><span></span></span
            >
            <h1 class="name">
              <span class="name__kicker">Hi, I'm</span>
              <span class="name__subject">Kuldeep Parmar</span>
            </h1>
            <p class="name__tagline">
              Software Engineer building scalable backend systems and robust cloud infrastructure.
            </p>
            <ul class="roles">
              <li><Pill><Icon icon="terminal-window" size="1.2em" /> Backend </Pill></li>
              <li><Pill><Icon icon="cloud" size="1.2em" /> DevOps</Pill></li>
              <li>
                <Pill><Icon icon="ai" size="1.2em" /> Automation/AI</Pill>
              </li>
              <li>
                <Pill><Icon icon="lock" size="1.2em" /> Security</Pill>
              </li>
            </ul>
          </header>
        </section>

        <div class="wrapper"><Skills /></div>
      </div>

      <div class="wrapper">
        <section class="section with-background with-cta">
          <header class="section-header stack gap-2 lg:gap-4">
            <h3>Selected Work</h3>
            <p>
              A collection of my recent projects, backend solutions, and infrastructure deployments.
            </p>
          </header>

          <div class="gallery">
            <Grid variant="offset">
              {
                projects.map((project) => (
                  <li>
                    <PortfolioPreview project={project} loading={"lazy"} />
                  </li>
                ))
              }
            </Grid>
          </div>

          <div class="cta">
            <CallToAction href="/work/">
              View all work
              <Icon icon="arrow-right" size="1.2em" />
            </CallToAction>
          </div>
        </section>
      </div>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  /* --- Hero field --------------------------------------------------------
     The grid is the backdrop for the whole masthead, bleeding to the viewport
     edges, while the content stays inside the wrapper. One column now: the
     right half is deliberately left to the field. */
  .hero-field {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(26rem, 58vh, 40rem);
    padding-block: 1rem 5rem;
  }

  /* The field is dimmest where the words are and fullest where the layout is
     empty, so a lit cell never fights the headline for attention. */
  :global(.hero-grid) {
    z-index: 0;
    opacity: 0.9;
    mask-image: linear-gradient(
      100deg,
      rgba(0, 0, 0, 0.2) 0%,
      rgba(0, 0, 0, 0.3) 28%,
      rgba(0, 0, 0, 0.72) 58%,
      rgba(0, 0, 0, 1) 100%
    );
    -webkit-mask-image: linear-gradient(
      100deg,
      rgba(0, 0, 0, 0.2) 0%,
      rgba(0, 0, 0, 0.3) 28%,
      rgba(0, 0, 0, 0.72) 58%,
      rgba(0, 0, 0, 1) 100%
    );
  }

  /* Dissolves the field into the page ground instead of ending on a hard row
     of cells. Sits above the canvas, below the content. */
  .hero-field__fade {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 42%;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, var(--gray-999) 90%);
  }

  .masthead {
    position: relative;
    z-index: 2;
    display: grid;
    gap: clamp(1.25rem, 2.4vw, 1.75rem);
    justify-items: center;
    text-align: center;
  }

  /* Racing stripes: three skewed bars of decreasing length. */
  .stripe {
    display: flex;
    gap: 0.3rem;
    width: fit-content;
  }

  .stripe span {
    height: 0.5rem;
    background: var(--gold);
    transform: skewX(-20deg);
  }

  .stripe span:nth-child(1) {
    width: clamp(1.9rem, 8vw, 2.6rem);
  }
  .stripe span:nth-child(2) {
    width: clamp(0.85rem, 3.6vw, 1.15rem);
  }
  .stripe span:nth-child(3) {
    width: clamp(0.38rem, 1.6vw, 0.52rem);
  }

  .name {
    display: grid;
    gap: 0.4rem;
    justify-items: center;
  }

  .name__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--gray-400);
    text-shadow: var(--engrave);
  }

  .name__subject {
    font-size: var(--text-display);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.94;
    color: var(--gray-0);
    text-shadow: var(--engrave);
    text-wrap: balance;
  }

  .name__tagline {
    max-width: 40ch;
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--gray-300);
    text-wrap: pretty;
  }

  .roles {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Staggered entry — never mount the masthead all at once. */
  .stripe,
  .name__kicker,
  .name__subject,
  .name__tagline,
  .roles {
    animation: rise 620ms cubic-bezier(0.22, 0.68, 0.35, 1) both;
    animation-delay: var(--enter-delay, 0ms);
  }

  .stripe {
    --enter-delay: 40ms;
  }
  .name__kicker {
    --enter-delay: 110ms;
  }
  .name__subject {
    --enter-delay: 180ms;
  }
  .name__tagline {
    --enter-delay: 260ms;
  }
  .roles {
    --enter-delay: 330ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 50em) {
    .masthead {
      /* Capped and left-aligned so the field keeps the right half open. */
      max-width: 44rem;
      margin-inline: 0;
      justify-items: start;
      text-align: start;
    }

    .name {
      justify-items: start;
    }

    .name__tagline {
      max-width: 38ch;
      font-size: var(--text-lg);
    }

    .roles {
      justify-content: flex-start;
    }
  }

  /* Centred text on small screens, so the directional mask no longer matches
     the layout — dim the whole field evenly instead. */
  @media (max-width: 49.99em) {
    :global(.hero-grid) {
      opacity: 0.8;
      mask-image: none;
      -webkit-mask-image: none;
    }
  }

  /* ====================================================== */

  .section {
    display: grid;
    gap: 2rem;
  }

  .with-background {
    position: relative;
  }

  .with-background::before {
    content: "";
    position: absolute;
    pointer-events: none;
    inset-inline: 0;
    width: auto;
    height: 100%;
    top: 50%;
    transform: translateY(-50%);
    background:
      url("/assets/backgrounds/noise.png") top center/220px repeat,
      radial-gradient(ellipse at center, var(--wash) 0%, transparent 70%);
    background-blend-mode: overlay, normal;
    opacity: var(--wash-opacity);
    z-index: -1;
  }

  @media (min-width: 50em) {
    .with-background::before {
      height: 150%;
      background:
        url("/assets/backgrounds/noise.png") top center/220px repeat,
        radial-gradient(ellipse at center, var(--wash) 0%, transparent 60%);
    }
  }

  .with-background.bg-variant::before {
    background:
      url("/assets/backgrounds/noise.png") top center/220px repeat,
      radial-gradient(ellipse at center, var(--wash) 0%, transparent 70%);
  }

  .section-header {
    justify-self: center;
    text-align: center;
    max-width: 50ch;
    font-size: var(--text-md);
    color: var(--gray-300);
    text-wrap: balance;
  }

  .section-header h3 {
    font-size: var(--text-2xl);
    letter-spacing: -0.025em;
  }

  @media (min-width: 50em) {
    .section {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas: "header header header header" "gallery gallery gallery gallery";
      gap: 5rem;
    }

    .section.with-cta {
      grid-template-areas: "header header header cta" "gallery gallery gallery gallery";
    }

    .section-header {
      grid-area: header;
      font-size: var(--text-lg);
    }

    .section-header h3 {
      font-size: var(--text-4xl);
    }

    .with-cta .section-header {
      justify-self: flex-start;
      text-align: left;
    }

    .gallery {
      grid-area: gallery;
    }

    .cta {
      grid-area: cta;
    }
  }

  /* ====================================================== */

  .mention-card {
    display: flex;
    height: 7rem;
    justify-content: center;
    align-items: center;
    text-align: center;
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    color: var(--gray-300);
    background: var(--gradient-subtle);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 50em) {
    .mention-card {
      border-radius: 1.5rem;
      height: 9.5rem;
    }
  }
</style>
