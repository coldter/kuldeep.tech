---
import { getCollection } from "astro:content";

// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Component Imports
import CallToAction from "../components/CallToAction.astro";
import Grid from "../components/Grid.astro";
import Icon from "../components/Icon.astro";
import PhosphorPlate from "../components/PhosphorPlate.astro";
import Pill from "../components/Pill.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";

// Page section components
import ContactCTA from "../components/ContactCTA.astro";
import Skills from "../components/Skills.astro";

// Content Fetching: List four most recent work projects
const projects = (await getCollection("work"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/
---

<BaseLayout>
  <div class="stack gap-20 lg:gap-48">
    <main id="main-content" tabindex="-1" class="wrapper stack gap-20 lg:gap-48">
      <div class="stack gap-8 lg:gap-20">
        <header class="masthead">
          <div class="masthead__legend">
            <span class="stripe" aria-hidden="true"
              ><span></span><span></span><span></span></span
            >
            <h1 class="name">
              <span class="name__kicker">Hi, I'm</span>
              <span class="name__subject">Kuldeep Parmar</span>
            </h1>
            <p class="name__tagline">
              Software Engineer building scalable backend systems and robust cloud infrastructure.
            </p>
            <ul class="roles">
              <li><Pill><Icon icon="terminal-window" size="1.2em" /> Backend </Pill></li>
              <li><Pill><Icon icon="cloud" size="1.2em" /> DevOps</Pill></li>
              <li>
                <Pill><Icon icon="ai" size="1.2em" /> Automation/AI</Pill>
              </li>
              <li>
                <Pill><Icon icon="lock" size="1.2em" /> Security</Pill>
              </li>
            </ul>
          </div>

          <PhosphorPlate class="masthead__plate" discipline="Software Engineer" model="KP-01" />
        </header>

        <Skills />
      </div>

      <section class="section with-background with-cta">
        <header class="section-header stack gap-2 lg:gap-4">
          <h3>Selected Work</h3>
          <p>
            A collection of my recent projects, backend solutions, and infrastructure deployments.
          </p>
        </header>

        <div class="gallery">
          <Grid variant="offset">
            {
              projects.map((project) => (
                <li>
                  <PortfolioPreview project={project} loading={"lazy"} />
                </li>
              ))
            }
          </Grid>
        </div>

        <div class="cta">
          <CallToAction href="/work/">
            View all work
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  /* --- Masthead ----------------------------------------------------------
     Two columns: the legend (what this is) and the plate (the object).
     Every word here is real content; the plate beside it is decorative. */
  .masthead {
    display: grid;
    gap: clamp(3rem, 7vw, 4.5rem);
    align-items: center;
  }

  .masthead__legend {
    display: grid;
    gap: 1.5rem;
    justify-items: center;
    text-align: center;
  }

  /* Racing stripes: three skewed bars of decreasing length. */
  .stripe {
    display: flex;
    gap: 0.3rem;
    width: fit-content;
  }

  .stripe span {
    height: 0.5rem;
    background: var(--gold);
    transform: skewX(-20deg);
  }

  .stripe span:nth-child(1) {
    width: clamp(1.9rem, 8vw, 2.6rem);
  }
  .stripe span:nth-child(2) {
    width: clamp(0.85rem, 3.6vw, 1.15rem);
  }
  .stripe span:nth-child(3) {
    width: clamp(0.38rem, 1.6vw, 0.52rem);
  }

  .name {
    display: grid;
    gap: 0.4rem;
    justify-items: center;
  }

  .name__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--gray-400);
    text-shadow: var(--engrave);
  }

  .name__subject {
    font-size: var(--text-display);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.94;
    color: var(--gray-0);
    text-shadow: var(--engrave);
    text-wrap: balance;
  }

  .name__tagline {
    max-width: 40ch;
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--gray-300);
    text-wrap: pretty;
  }

  .roles {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Staggered entry — never mount the masthead all at once. */
  .stripe,
  .name__kicker,
  .name__subject,
  .name__tagline,
  .roles,
  .masthead__plate {
    animation: rise 620ms cubic-bezier(0.22, 0.68, 0.35, 1) both;
    animation-delay: var(--enter-delay, 0ms);
  }

  .stripe {
    --enter-delay: 40ms;
  }
  .name__kicker {
    --enter-delay: 110ms;
  }
  .name__subject {
    --enter-delay: 180ms;
  }
  .name__tagline {
    --enter-delay: 260ms;
  }
  .roles {
    --enter-delay: 330ms;
  }
  .masthead__plate {
    --enter-delay: 180ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 50em) {
    .masthead {
      grid-template-columns: 6fr 4fr;
      gap: clamp(2.5rem, 4vw, 4rem);
    }

    .masthead__legend {
      gap: 1.75rem;
      justify-items: start;
      text-align: start;
    }

    .name {
      justify-items: start;
    }

    .name__tagline {
      max-width: 38ch;
      font-size: var(--text-lg);
    }

    .roles {
      justify-content: flex-start;
    }
  }

  /* ====================================================== */

  .section {
    display: grid;
    gap: 2rem;
  }

  .with-background {
    position: relative;
  }

  .with-background::before {
    content: "";
    position: absolute;
    pointer-events: none;
    inset-inline: 0;
    width: auto;
    height: 100%;
    top: 50%;
    transform: translateY(-50%);
    background:
      url("/assets/backgrounds/noise.png") top center/220px repeat,
      radial-gradient(ellipse at center, var(--wash) 0%, transparent 70%);
    background-blend-mode: overlay, normal;
    opacity: var(--wash-opacity);
    z-index: -1;
  }

  @media (min-width: 50em) {
    .with-background::before {
      height: 150%;
      background:
        url("/assets/backgrounds/noise.png") top center/220px repeat,
        radial-gradient(ellipse at center, var(--wash) 0%, transparent 60%);
    }
  }

  .with-background.bg-variant::before {
    background:
      url("/assets/backgrounds/noise.png") top center/220px repeat,
      radial-gradient(ellipse at center, var(--wash) 0%, transparent 70%);
  }

  .section-header {
    justify-self: center;
    text-align: center;
    max-width: 50ch;
    font-size: var(--text-md);
    color: var(--gray-300);
    text-wrap: balance;
  }

  .section-header h3 {
    font-size: var(--text-2xl);
    letter-spacing: -0.025em;
  }

  @media (min-width: 50em) {
    .section {
      grid-template-columns: repeat(4, 1fr);
      grid-template-areas: "header header header header" "gallery gallery gallery gallery";
      gap: 5rem;
    }

    .section.with-cta {
      grid-template-areas: "header header header cta" "gallery gallery gallery gallery";
    }

    .section-header {
      grid-area: header;
      font-size: var(--text-lg);
    }

    .section-header h3 {
      font-size: var(--text-4xl);
    }

    .with-cta .section-header {
      justify-self: flex-start;
      text-align: left;
    }

    .gallery {
      grid-area: gallery;
    }

    .cta {
      grid-area: cta;
    }
  }

  /* ====================================================== */

  .mention-card {
    display: flex;
    height: 7rem;
    justify-content: center;
    align-items: center;
    text-align: center;
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    color: var(--gray-300);
    background: var(--gradient-subtle);
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 50em) {
    .mention-card {
      border-radius: 1.5rem;
      height: 9.5rem;
    }
  }
</style>
