---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

import ContactCTA from "../../components/ContactCTA.astro";
import PortfolioPreview from "../../components/PortfolioPreview.astro";
import Hero from "../../components/Hero.astro";
import Grid from "../../components/Grid.astro";

const projects = (await getCollection("work")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<BaseLayout
  title="Work | Kuldeep Parmar"
  description="Past projects, client work, and writing"
>
  <div class="stack gap-20">
    <main id="main-content" tabindex="-1" class="wrapper stack gap-8">
      <Hero
        title="Work"
        tagline="Past projects and client work, plus occasional notes on side projects."
        align="start"
      />
      {
        projects.length === 0 ? (
          <p role="status">No projects yet — check back soon.</p>
        ) : (
          <Grid variant="offset">
            {projects.map((project, index) => (
              <li>
                <PortfolioPreview
                  project={project}
                  loading={[0, 1, 3].includes(index) ? "eager" : "lazy"}
                />
              </li>
            ))}
          </Grid>
        )
      }
    </main>
    <ContactCTA />
  </div>
</BaseLayout>
